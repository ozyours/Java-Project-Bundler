<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.jpb</groupId>
    <artifactId>java-project-bundler</artifactId>
    <version>1.0</version>
    <packaging>jar</packaging>

    <name>Java Project Bundler</name>
    <description>Desktop utility that packages Java (Maven/Gradle) projects into self-contained distribution bundles.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>

        <!-- JavaFX 21 LTS line; must be >= 17 to run -->
        <javafx.version>21.0.12</javafx.version>
        <!-- AtlantaFX 2.0.1 is built against JavaFX 20, compatible with 21 -->
        <atlantafx.version>2.0.1</atlantafx.version>
        <orgjson.version>20260719</orgjson.version>
        <junit.version>5.14.4</junit.version>

        <javafx.maven.plugin.version>0.0.8</javafx.maven.plugin.version>
        <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
        <maven.surefire.plugin.version>3.2.5</maven.surefire.plugin.version>
    </properties>

    <dependencies>
        <!-- UI framework (SDD.md §3.1) -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- AtlantaFX theme (PrimerLight / PrimerDark) and controls (SDD.md §3.1) -->
        <dependency>
            <groupId>io.github.mkpaz</groupId>
            <artifactId>atlantafx-base</artifactId>
            <version>${atlantafx.version}</version>
        </dependency>

        <!-- JSON persistence for .jpb builder project files (SDD.md §3.1) -->
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>${orgjson.version}</version>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.plugin.version}</version>
            </plugin>

            <!--
                Manifest Main-Class so the produced JAR is launchable both directly
                (java -jar) and from the bundles this tool creates. It must be the
                plain launcher com.jpb.bundler.Main, not MainApp: the JVM refuses to
                start a class extending javafx.application.Application unless JavaFX
                is on the module path, which the bundle launcher (classpath mode) and
                plain java -jar both lack.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.jpb.bundler.Main</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.plugin.version}</version>
            </plugin>

            <!-- Run the app with: mvn javafx:run -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>${javafx.maven.plugin.version}</version>
                <configuration>
                    <mainClass>com.jpb.bundler.MainApp</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
